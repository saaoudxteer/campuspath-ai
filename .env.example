# Local development. Copy to .env; the launcher loads it for both services.
DEMO_MODE=true
# Enable secure HTTPS cookies for an online demo:
# SESSION_COOKIE_SECURE=true
# PUBLIC_APP_URL=https://your-host.example
STORAGE_BACKEND=local
API_INTERNAL_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PostgreSQL option: docker compose up -d db, then uncomment.
# DATABASE_URL=postgresql+psycopg://campuspath:campuspath_local_dev_only@127.0.0.1:5433/campuspath

# Production requires DEMO_MODE=false, PostgreSQL, HTTPS and S3 storage.
# STORAGE_BACKEND=s3
# S3_BUCKET=your-private-bucket
# S3_ENDPOINT_URL=https://your-s3-endpoint
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
# ALLOWED_ORIGINS=https://your-candidate-app.example

# The typed LLM adapter is an integration boundary, not auto-enabled by env vars.
# Never place credentials in NEXT_PUBLIC_* variables.
